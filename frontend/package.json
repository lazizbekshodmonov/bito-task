    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "apexcharts": "^5.3.6",
    "axios": "^1.6.8",
    "naive-ui": "^2.38.1",
    "pinia": "^2.1.7",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.1.18",
    "unplugin-auto-import": "^21.0.0",
